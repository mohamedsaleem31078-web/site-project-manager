using Microsoft.EntityFrameworkCore;
using SiteProjectManager.Data;
using SiteProjectManager.Models;

namespace SiteProjectManager.Services;

public class SeedDataService
{
    public static async Task SeedAsync(AppDbContext context)
    {
        await context.Database.MigrateAsync();

        if (!await context.Projects.AnyAsync())
        {
            var project = new Project
            {
                Name = "Sample Project",
                ClientName = "Client Name",
                SiteName = "Site 01",
                Address = "Project Address",
                StartDate = DateTime.UtcNow.AddDays(-10),
                EndDate = DateTime.UtcNow.AddDays(90),
                Status = "In Progress",
                Notes = "Sample project for demonstration.",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            context.Projects.Add(project);
            await context.SaveChangesAsync();

            var snag = new Snag
            {
                ProjectId = project.Id,
                Title = "Defective wall finish",
                Description = "Wall surface needs rework in zone A.",
                Category = "Quality",
                Priority = "High",
                Status = "Open",
                CreatedAt = DateTime.UtcNow,
                DueDate = DateTime.UtcNow.AddDays(7),
                AssignedTo = "Site Engineer",
                LocationDescription = "Zone A - North wall",
                Notes = "Need inspection"
            };

            context.Snags.Add(snag);
            await context.SaveChangesAsync();
        }
    }
}
